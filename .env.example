# ── LLM Provider circular queue ──────────────────────────────
# Formato: LLM_KEY_N=proveedor:api_key
# Proveedores soportados: gemini, claude, openai, openrouter, groq, deepseek, mistral
LLM_KEY_1=gemini:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_KEY_2=openrouter:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_KEY_3=groq:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_KEY_4=deepseek:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_KEY_5=mistral:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
.
.
LLM_KEY_N=name:api_key

# ── Modelos por proveedor (opcionales, tienen defaults) ───────
GEMINI_MODEL=gemini-1.5-flash
CLAUDE_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_MODEL=openrouter/auto
GROQ_MODEL=llama-3.1-8b-instant
DEEPSEEK_MODEL=deepseek-chat
MISTRAL_MODEL=mistral-small-latest

# ── Backend ───────────────────────────────────────────────────
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
