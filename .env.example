# ══════════════════════════════════════════════════════
#  PathForge Configuration
# ══════════════════════════════════════════════════════

# ── LLM Provider circular queue ──────────────────────
# Soporta: gemini, claude, openai (o mezcla de ellos)
# El sistema usa una cola circular: cuando una key se
# queda sin tokens, pasa automáticamente a la siguiente.
# Puedes poner tantas keys como quieras con cualquier
# proveedor. El nombre del proveedor va antes del ":" 
# en cada key entry.
#
# Formato: LLM_KEY_N=provider:api_key_value
#
LLM_KEY_1=gemini:your_gemini_api_key_here
LLM_KEY_2=gemini:your_second_gemini_key_here
LLM_KEY_3=claude:your_claude_api_key_here
LLM_KEY_4=openai:your_openai_api_key_here

# ── Modelos por proveedor (opcionales, tiene defaults) ─
GEMINI_MODEL=gemini-1.5-flash
CLAUDE_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-4o-mini

# ── Backend ───────────────────────────────────────────
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000